# ------------------------------------------------------------------
# Copy this file to ".env" and fill in your real values:
#     cp .env.example .env      (macOS / Linux)
#     copy .env.example .env    (Windows)
#
# The .env file is git-ignored and stays on your machine only.
# NEVER commit your real API key to git or share it publicly.
# ------------------------------------------------------------------

# REQUIRED. Your free Google Gemini API key.
# Get one in ~1 minute at https://aistudio.google.com/apikey  (no credit card needed).
GEMINI_API_KEY=your_gemini_api_key_here

# OPTIONAL. Which Gemini model to use.
# "gemini-3.6-flash" is a fast, capable model available on the free tier (recommended default).
# Other free-tier options you can try: "gemini-3.8-flash", "gemini-3.5-flash-lite".
GEMINI_MODEL=gemini-3.6-flash

# OPTIONAL. Which embedding model powers retrieval (the RAG system).
# "gemini-embedding-001" is Google's current embedding model, free-tier friendly.
GEMINI_EMBED_MODEL=gemini-embedding-001

# OPTIONAL. Embedding vector size. 768 is a good balance of quality vs. storage.
# Supported values include 768, 1536, and 3072 (larger = slightly better, bigger files).
EMBED_DIM=768

# OPTIONAL. How many profile chunks to retrieve per question (the "top-K").
RAG_TOP_K=6

# OPTIONAL. Minimum similarity score (0–1) a chunk needs to be included.
# The single best match is always kept even if it falls below this floor.
RAG_MIN_SCORE=0.15

# OPTIONAL. Port the local server listens on. Defaults to 3000.
PORT=3000
